{
  "manifest_version": 3,
  "name": "inspo sync",
  "version": "1.1.0",
  "description": "Haalt je opgeslagen Instagram-posts, thumbnails en video's op voor inspo.michielmeilink.com.",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://inspo.michielmeilink.com/*", "http://localhost:8765/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "128": "icon.png" }
}
